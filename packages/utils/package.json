{
  "name": "@omniflow/utils",
  "version": "0.1.0",
  "private": true,
  "description": "Shared utilities (logger, error handling, helpers)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@omniflow/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
