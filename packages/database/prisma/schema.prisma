generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enable pgvector extension for AI embeddings (Phase 13+)
// CREATE EXTENSION IF NOT EXISTS vector;

// Phase 2: Authentication & Multi-Tenancy

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum PermissionScope {
  GLOBAL
  TENANT
  BRANCH
  TEAM
  OWN
}

model Tenant {
  id String @id @default(cuid())
  name String
  slug String @unique
  status TenantStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  roles Role[]
  refreshTokens RefreshToken[]
  branches Branch[]
  userBranches UserBranch[]

  @@index([status])
}

model User {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email String @unique
  passwordHash String
  status UserStatus @default(ACTIVE)

  mfaEnabled Boolean @default(false)
  mfaSecret String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles UserRole[]
  refreshTokens RefreshToken[]
  mfaRecoveryCodes MfaRecoveryCode[]
  branches UserBranch[]

  @@index([tenantId, status])
  @@index([email])
}

model Role {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  users UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id String @id @default(cuid())
  code String @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  scope PermissionScope @default(TENANT)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RefreshToken {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  replacedByTokenId String?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
}

model MfaRecoveryCode {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash String
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

// Phase 3: Branches

enum BranchStatus {
  ACTIVE
  INACTIVE
}

model Branch {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String
  slug String
  status BranchStatus @default(ACTIVE)
  address String?
  timezone String @default("UTC")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserBranch[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model UserBranch {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, branchId])
  @@index([branchId])
  @@index([tenantId])
}
